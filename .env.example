# Chati-AI deployment example
# Never put a real API key in this file if you commit it.

OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-5.6-terra
OPENAI_MEMORY_MODEL=gpt-5.6-luna
OPENAI_AUDIO_MODEL=gpt-audio-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

PORT=3000
NODE_ENV=development

# Set to 1 only when deployed behind a trusted reverse proxy.
TRUST_PROXY=0

JSON_BODY_LIMIT=50mb
API_RATE_LIMIT_WINDOW_MS=600000
CHAT_RATE_LIMIT_MAX=80
MEMORY_RATE_LIMIT_MAX=120
